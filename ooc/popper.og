::dense
return|holdout-read|P2
::end
::assertion
trigger: verdicts >= charter.max_tested OR Steward stop OR empty hinge
check: one holdout comparison by the Critic if the base changed; last event kind = return with P2; R1-R16
on-pass: halt
on-fail: ->[:requires] contract
::end
