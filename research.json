  "conjecturer": {
    "type": "II",
    "feedback": "positive",
    "reads": [
      "charter",
      "base",
      "every verdict",
      "every refuted diff"
    ],
    "never": [
      "holdout",
      "a result of its own pending conjecture before the verdict"
    ],
    "kinds": [
      "improves",
      "simplifies"
    ]
  },
  "critic": {
    "type": "I",
    "feedback": "negative",
    "percept": [
      "diff",
      "kind",
      "delta",
      "base results",
      "own run results"
    ],
    "replicates": 3,
    "seed": "seed_i = int(hex(sha256(root || \"seed/\" || i))[0:8], 16), i = 1..3, root = trace root just after the event that registers the arm",
    "test": {
      "improves": "corroborated iff max(h) < min(b) and mean(h) - mean(b) <= -delta; refute at the first h_i >= min(b)",
      "simplifies": "corroborated iff the diff deletes more lines than it adds and mean(h) - mean(b) <= delta, where delta is delta_min at registration"
    },
    "alpha": 0.05,
    "ties": "for improves, h_i = min(b) refutes",
    "crash": "inconclusive; a missing or non-finite val_bpb is a crash"
  },
